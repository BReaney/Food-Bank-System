# Local development environment - copy to backend/.env, then replace values.
PGHOST=localhost
PGPORT=5432
PGDATABASE=foodbank_dev
PGUSER=foodbank_app
PGPASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD

# Demo security gate: no authenticated prototype routes unless enabled.
# Authentication and booking endpoints are also disabled in production.
ENABLE_PROTOTYPE_AUTH=true
FRONTEND_ORIGIN=http://localhost:5173

# Use two DIFFERENT strong fictional test-account passwords, 12+ characters.
# Never add these to GitHub or share them with anyone.
DEMO_STAFF_PASSWORD=REPLACE_WITH_UNIQUE_TEST_PASSWORD
DEMO_STUDENT_PASSWORD=REPLACE_WITH_DIFFERENT_TEST_PASSWORD
