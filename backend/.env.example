# Copy this file to backend/.env; never commit your real .env file.
PGHOST=localhost
PGPORT=5432
PGDATABASE=foodbank_dev
PGUSER=foodbank_app
PGPASSWORD=REPLACE_WITH_YOUR_LOCAL_DATABASE_PASSWORD

# This enables write operations for the fixed fictional demo student.
# Leave disabled unless testing on your own local computer.
ENABLE_DEMO_BOOKING=false
